DATABASE_URL=postgresql://sentinel:REPLACE_LOCALLY@127.0.0.1:5432/sentinelscan?schema=sentinelscan
WEB_ORIGIN=http://127.0.0.1:3000
API_HOST_HEADER=127.0.0.1:4000
ZAP_TIMEOUT_MS=5000
# Set to juice-shop to allow the exact local demonstration target.
SENTINELSCAN_DEMO_TARGET=
# Optional AI analysis. Disabled unless the provider is "anthropic" and a key is set.
# Calls are billed by the provider. Keep the key private to this file.
SENTINELSCAN_AI_PROVIDER=
ANTHROPIC_API_KEY=
SENTINELSCAN_AI_MODEL=claude-opus-5-5
SENTINELSCAN_AI_TIMEOUT_MS=120000
